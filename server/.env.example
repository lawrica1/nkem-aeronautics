PORT=5000
# connect_timeout=15: Neon suspends idle databases, and waking one takes longer than
# Prisma's default 5s connect timeout — without it the first requests after idle 500.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&connect_timeout=15
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:3000

# OTP delivery is provider-backed later. Development logs/debug-returns OTPs.
OTP_PROVIDER=console

# Termii (https://termii.com) sends the real SMS for OTP verification.
# Leave TERMII_API_KEY unset to keep logging OTPs to the console instead (dev/testing).
# TERMII_SENDER_ID must be a sender ID registered/approved on your Termii account.
TERMII_API_KEY=replace-with-termii-api-key
TERMII_SENDER_ID=N-Alert
TERMII_CHANNEL=generic

# Email delivery — two options (BREVO takes priority when its key is set):
#
# Option A — Brevo HTTP API (recommended for production / Railway).
# Sign up free at brevo.com, verify nkemaeronautics.com as a sender domain,
# then paste the API key below. 300 emails/day free.
# Set SMTP_USER to the verified sender address (e.g. nkem@nkemaeronautics.com).
BREVO_API_KEY=replace-with-brevo-api-key
SMTP_USER=nkem@nkemaeronautics.com
#
# Option B — Gmail SMTP (local dev / fallback).
# SMTP_PASS must be a Gmail App Password (Google Account → Security →
# 2-Step Verification → App passwords).
# Leave both BREVO_API_KEY and SMTP_PASS unset to log emails to console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_PASS=replace-with-a-gmail-app-password

# Cloudflare R2 / S3-compatible object storage.
# Account ID is found in the Cloudflare dashboard → R2 Overview (right sidebar).
# R2_ENDPOINT  — use the account endpoint, NOT the bucket URL.
# R2_PUBLIC_BASE_URL — the public URL prefix for served files.
#   • If you enabled R2.dev access, it looks like: https://pub-<hash>.r2.dev
#   • If you linked a custom domain: https://media.yourdomain.com
#   Note: do NOT include the bucket name at the end; the service appends the key.
R2_ENDPOINT=https://8349db45aba0c1721d6d89750c34129d.r2.cloudflarestorage.com
R2_BUCKET=nkem-aeronautics-media
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_PUBLIC_BASE_URL=https://replace-with-your-r2-public-url

# Flutterwave (https://dashboard.flutterwave.com) — online checkout by card, MTN MoMo, and
# Orange Money. Chosen because it's the only major processor that onboards Cameroon-registered
# merchants (Stripe and Paystack do not) and is also licensed in Zambia for later expansion.
# Get FLUTTERWAVE_SECRET_KEY from Settings -> API, and set FLUTTERWAVE_WEBHOOK_HASH to a
# secret string you also paste into Settings -> Webhooks on the dashboard (a plain shared
# secret compare, not an HMAC). Use the "Test" (sandbox) keys until KYC is approved.
FLUTTERWAVE_SECRET_KEY=replace-with-flutterwave-secret-key
FLUTTERWAVE_WEBHOOK_HASH=replace-with-a-random-webhook-secret

# Admin alert notifications — fired whenever a new inquiry/quote is submitted via the contact
# form or any service page. Both are optional; set whichever channels you want active.
# ADMIN_EMAIL: the inbox that receives the email alert (can be the same as SMTP_USER).
# ADMIN_PHONE: the number that receives the SMS alert via Termii (international format, e.g. +260976123456).
ADMIN_EMAIL=nkemaeronautics@gmail.com
ADMIN_PHONE=+260976000000
