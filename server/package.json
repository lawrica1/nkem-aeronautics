{
  "name": "nkem-aeronautics-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "node --check src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "db:sync": "prisma db push --skip-generate",
    "db:check": "node scripts/check-database.mjs",
    "storage:check": "node scripts/check-storage.mjs",
    "email:check": "node scripts/check-email.mjs",
    "create-admin": "node scripts/create-admin.mjs",
    "seed-drones": "node scripts/seed-drones.mjs",
    "seed-catalog": "node scripts/seed-catalog.mjs",
    "seed-website-products": "node scripts/seed-website-products.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@google/genai": "^2.30.0",
    "@prisma/client": "^6.16.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "prisma": "^6.16.1"
  },
