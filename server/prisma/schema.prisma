generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  farmer
  organization
  government
  pilot
  admin
  partner
}

enum Sector {
  agricultural
  wildlife
  mining
}

enum AccountType {
  individual
  organization
  government
}

enum RequestStatus {
  submitted
  under_review
  processing
  assigned
  in_progress
  completed
  rejected
  cancelled
  requires_info
}

enum OrderStatus {
  pending_payment
  paid
  processing
  ready
  completed
  cancelled
  payment_failed
}

enum PartRequestStatus {
  submitted
  in_review
  identified
  unavailable
  closed
}

enum QuoteRequestStatus {
  new
  contacted
  closed
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  type         String   @default("private")
  sector       String?
  contactName  String?
  contactPhone String?
  active       Boolean  @default(true)
  members      User[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Pilot {
  id         String      @id @default(cuid())
  name       String
  telephone  String?
  email      String?
  droneTypes String      @default("")
  active     Boolean     @default(true)
  userId     String?     @unique
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  operations Operation[]
  reviews    Review[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Drone {
  id         String           @id @default(cuid())
  name       String
  model      String?
  type       String?
  specs      String           @default("")
  active     Boolean          @default(true)
  operations Operation[]
  telemetry  DroneTelemetry[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model DroneTelemetry {
  id          String     @id @default(cuid())
  droneId     String
  drone       Drone      @relation(fields: [droneId], references: [id], onDelete: Cascade)
  operationId String?
  operation   Operation? @relation(fields: [operationId], references: [id], onDelete: SetNull)
  latitude    Float
  longitude   Float
  altitude    Float?
  heading     Float?
  speed       Float?
  recordedAt  DateTime   @default(now())
  createdAt   DateTime   @default(now())

  @@index([droneId, recordedAt])
  @@index([operationId, recordedAt])
}

model NewsPost {
  id          String   @id @default(cuid())
  title       String
  category    String   @default("company")
  summary     String   @default("")
  body        String
  imageUrl    String?
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, publishedAt])
}

model Operation {
  id               String         @id @default(cuid())
  serviceRequestId String         @unique
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pilotId          String?
  pilot            Pilot?         @relation(fields: [pilotId], references: [id], onDelete: SetNull)
  droneId          String?
  drone            Drone?         @relation(fields: [droneId], references: [id], onDelete: SetNull)
  scheduledAt      DateTime?
  chemical         String         @default("")
  region           String         @default("")
  comments         String         @default("")
  results          String         @default("")
  review           Review?
  files            FileAsset[]
  telemetry        DroneTelemetry[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId, createdAt])
  @@index([pilotId])
  @@index([droneId])
}

model Review {
  id          String    @id @default(cuid())
  operationId String    @unique
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pilotId     String
  pilot       Pilot     @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String    @default("")
  createdAt   DateTime  @default(now())

  @@index([pilotId])
}

model Product {
  id            String      @id @default(cuid())
  sector        String
  name          String
  slug          String?     @unique
  type          String?
  model         String?
  price         Int?
  availability  String      @default("")
  description   String      @default("")
  specs         Json?
  images        String[]    @default([])
  featureBadges String[]    @default([])
  applications  String[]    @default([])
  active        Boolean     @default(true)
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      OrderStatus @default(pending_payment)
  channel     String      @default("online")
  totalAmount Int         @default(0)
  notes       String      @default("")
  items           OrderItem[]
  payments        Payment[]
  paymentAttempts PaymentAttempt[]
  receipt         Receipt?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// A checkout the customer started with the payment gateway. Distinct from Payment (a
// CONFIRMED, ledger-worthy payment) so a pending/failed gateway attempt never counts
// toward "how much has actually been paid" — and so a replayed webhook can't double-credit
// an order: confirmation only proceeds if this row's status is still "pending" (see
// payment.service.js's atomic claim via updateMany).
model PaymentAttempt {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider     String   @default("flutterwave")
  txRef        String   @unique
  providerTxId String?
  status       String   @default("pending")
  amount       Int
  checkoutUrl  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orderId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  unitPrice Int     @default(0)

  @@index([orderId])
}

model Payment {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Int
  method    String
  reference String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Receipt {
  id            String   @id @default(cuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receiptNumber String   @unique
  issuedAt      DateTime @default(now())
}

model PartRequest {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  status      PartRequestStatus @default(submitted)
  adminNotes  String            @default("")
  files       FileAsset[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String   @default("")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

model User {
  id                   String           @id @default(cuid())
  role                 Role             @default(farmer)
  sector               Sector?
  accountType          AccountType      @default(individual)
  country              String           @default("CM")
  surname              String?
  name                 String?
  sex                  String?
  telephone            String?
  email                String           @unique
  address              String?
  region               String?
  district             String?
  crop                 String?
  otherCrop            String?
  firm                 String?
  otherFirm            String?
  wildlifeOrg          String?
  wildlifeRole         String?
  miningOrg            String?
  miningRole           String?
  profilePhotoKey      String?
  profilePhotoUrl      String?
  passwordHash         String?
  tokenVersion         Int              @default(0) // bump to sign the user out of every device
  isVerified           Boolean          @default(false)
  isProfileComplete    Boolean          @default(false)
  identificationNumber String?          @unique
  otpHash              String?
  otpChannel           String?
  otpContact           String?
  otpExpiresAt         DateTime?
  otpResendCount       Int              @default(0)
  otpLastSentAt        DateTime?
  requests             ServiceRequest[]
  partnerRequests      ServiceRequest[] @relation("PartnerRequests")
  files                FileAsset[]
  operations           Operation[]
  reviews              Review[]
  orders               Order[]
  partRequests         PartRequest[]
  notifications        Notification[]
  pilotProfile         Pilot?
  organizationId       String?
  organization         Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([role, sector])
  @@index([country, region, district])
}

model ServiceRequest {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  service     String
  description String        @default("")
  location    String        @default("")
  region      String        @default("")
  firm        String?
  status      RequestStatus @default(submitted)
  adminNotes  String        @default("")
  partnerId   String?
  partner     User?         @relation("PartnerRequests", fields: [partnerId], references: [id], onDelete: SetNull)
  files       FileAsset[]
  operation   Operation?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([firm, createdAt])
  @@index([partnerId, createdAt])
}

model Counter {
  key String @id
  seq Int    @default(0)
}

model FileAsset {
  id               String          @id @default(cuid())
  ownerId          String?
  owner            User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  serviceRequestId String?
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  partRequestId    String?
  partRequest      PartRequest?    @relation(fields: [partRequestId], references: [id], onDelete: SetNull)
  operationId      String?
  operation        Operation?      @relation(fields: [operationId], references: [id], onDelete: SetNull)
  purpose          String          @default("general")
  originalName     String
  key              String          @unique
  url              String
  mimeType         String
  size             Int
  createdAt        DateTime        @default(now())

  @@index([ownerId, purpose])
  @@index([serviceRequestId])
  @@index([partRequestId])
  @@index([operationId])
}

model QuoteRequest {
  id                String             @id @default(cuid())
  sector            String
  name              String?
  email             String
  whatsapp          String?
  company           String?
  targetCountry     String?
  interestedProduct String?
  interestedIn      String?
  message           String
  status            QuoteRequestStatus @default(new)
  adminNotes        String             @default("")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([sector, createdAt])
}
