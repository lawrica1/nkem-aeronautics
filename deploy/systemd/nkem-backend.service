[Unit]
Description=Nkem Aeronautics Express Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/nkem-aeronautics-runtime/current/server
EnvironmentFile=/var/www/nkem-aeronautics-runtime/shared/server.env
ExecStart=/usr/bin/node /var/www/nkem-aeronautics-runtime/current/server/src/server.js
Restart=always
RestartSec=5
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nkem-backend
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
